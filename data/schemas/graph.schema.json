{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiderverse-ai.local/schemas/graph.schema.json",
  "title": "SpiderVerse AI graph dataset",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "properties": {
    "meta": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "type", "properties"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "properties": {
            "type": "object",
            "required": ["source_title", "source_type", "verified"]
          }
        }
      }
    }
  }
}
